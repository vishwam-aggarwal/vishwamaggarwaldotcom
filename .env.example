# Comments (Cusdis) — create a free project at https://cusdis.com and paste
# its App ID here. Must be prefixed PUBLIC_ since Astro exposes it client-side.
# Set the same value in Vercel: Project Settings → Environment Variables.
PUBLIC_CUSDIS_APP_ID=

# GitHub content token — used at build time only (never exposed to the
# client, so no PUBLIC_ prefix) by src/loaders/github-article.ts to fetch
# each project's article.md from its own GitHub repo. Needs read access to
# repo contents for whichever repos are listed in src/content.config.ts's
# articleSources — a fine-grained PAT (github.com/settings/personal-access-tokens/new)
# scoped to just those repos, "Contents: Read-only", is the right shape;
# don't reuse a broad personal-account token here. Set the same value in
# Vercel: Project Settings → Environment Variables.
GITHUB_CONTENT_TOKEN=
