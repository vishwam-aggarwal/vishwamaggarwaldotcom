# build output
dist/
.astro/

# images fetched at build time from project repos' article.md sources
# (src/loaders/github-article.ts) -- regenerated fresh every build, same
# reasoning as dist/.astro/ above: committing a copy risks it going stale
# if the source image ever changes.
public/images/

# same reasoning, for Tools-section web apps fetched from their own
# project repos at build time (src/loaders/github-tool-app.ts). This
# used to be a one-time copy-paste that had already gone stale relative
# to the source repo before the loader existed.
public/tools/*/app/

# dependencies
node_modules/

# logs
npm-debug.log*

# environment variables
.env
.env.production

# macOS-ish/OS junk
.DS_Store
Thumbs.db

# editor
.vscode/*
!.vscode/extensions.json
.idea/

.vercel
.env*
