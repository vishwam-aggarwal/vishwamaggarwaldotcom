---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const tools = await getCollection('toolPages', ({ data }) => !data.draft);
---

<BaseLayout title="Tools" description="Browser-based tools by Vishwam Aggarwal that talk directly to your hardware.">
  <h1>Tools</h1>
  <p style="color: var(--text-dim); margin-bottom: 2rem;">
    Small, self-contained web apps that talk directly to hardware over
    <a href="https://developer.mozilla.org/en-US/docs/Web/API/Web_Serial_API" target="_blank" rel="noopener noreferrer">Web Serial</a>
    &mdash; no install, no account, nothing sent to a server. Chrome or Edge on desktop only; Web Serial isn't implemented in Firefox or Safari.
  </p>

  {tools.length === 0 ? (
    <div class="empty-state">
      <p>No tools published yet — check back soon.</p>
    </div>
  ) : (
    <div class="project-grid">
      {tools.map((tool) => (
        <article class="project-card">
          <div class="tag-row">
            <span class="status-badge">{tool.data.status}</span>
            {tool.data.tags.map((tag: string) => <span class="tag">{tag}</span>)}
          </div>
          <h3><a href={`/tools/${tool.id}/`}>{tool.data.title}</a></h3>
          <p>{tool.data.description}</p>
          <div class="project-links">
            <a href={`/tools/${tool.id}/`}>Read more &rarr;</a>
          </div>
        </article>
      ))}
    </div>
  )}
</BaseLayout>
