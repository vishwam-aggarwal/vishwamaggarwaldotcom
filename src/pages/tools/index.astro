---
import BaseLayout from '../../layouts/BaseLayout.astro';

const tools = [
  {
    slug: 'servo-calibrator',
    title: 'Servo Calibrator',
    summary: 'Characterize a hobby servo’s real pulse↔angle curve with an AS5600 encoder, then drive and visualize live trajectories against it — right in your browser.',
    tags: ['Web Serial', 'Robotics', 'Arduino'],
    status: 'active',
  },
];
---

<BaseLayout title="Tools" description="Browser-based tools by Vishwam Aggarwal that talk directly to your hardware.">
  <h1>Tools</h1>
  <p style="color: var(--text-dim); margin-bottom: 2rem;">
    Small, self-contained web apps that talk directly to hardware over
    <a href="https://developer.mozilla.org/en-US/docs/Web/API/Web_Serial_API" target="_blank" rel="noopener noreferrer">Web Serial</a>
    &mdash; no install, no account, nothing sent to a server. Chrome or Edge on desktop only; Web Serial isn't implemented in Firefox or Safari.
  </p>
  <div class="project-grid">
    {tools.map((tool) => (
      <article class="project-card">
        <div class="tag-row">
          <span class="status-badge">{tool.status}</span>
          {tool.tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
        <h3><a href={`/tools/${tool.slug}/`}>{tool.title}</a></h3>
        <p>{tool.summary}</p>
        <div class="project-links">
          <a href={`/tools/${tool.slug}/`}>Read more &rarr;</a>
        </div>
      </article>
    ))}
  </div>
</BaseLayout>
